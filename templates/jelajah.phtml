$this->headTitle('Berkas');
$dasar   = $this->alamatDasar;
$alamat  = static fn (array $q): string => $dasar . (($q = array_filter($q, static fn ($v): bool => $v !== null && $v !== '')) === [] ? '' : '?' . http_build_query($q));
$sekarang = array_filter([
    'lihat'  => $this->folder === null && $this->mode !== 'cari' ? $this->lihat : null,
    'folder' => $this->folder?->kode,
    'cari'   => $this->cari,
    'tampil' => $this->tampil === 'ikon' ? 'ikon' : null,
], static fn ($v): bool => $v !== null && $v !== '');
$kembali = $sekarang === [] ? '' : '?' . http_build_query($sekarang);
$tampilLain = $sekarang;
if ($this->tampil === 'ikon') {
    unset($tampilLain['tampil']);
} else {
    $tampilLain['tampil'] = 'ikon';
}
$csrf  = '<input type="hidden" name="' . $this->escapeHtmlAttr($this->fieldCsrf) . '" value="' . $this->escapeHtmlAttr($this->tokenCsrf) . '">';
$balik = '<input type="hidden" name="kembali" value="' . $this->escapeHtmlAttr($kembali) . '">';
$judulMode = match ($this->mode) {
    'bagi'   => 'Dibagikan dengan saya',
    'sampah' => 'Tempat sampah',
    'cari'   => 'Hasil pencarian',
    default  => $this->lokasiMilik[$this->lokasiAktif] ?? 'Berkas',
};
