// Menu tindakan satu berkas (⋮).
$menu = function (array $b) use ($csrf, $balik): string {
    $e  = fn (string $s): string => $this->escapeHtmlAttr($s);
    $h  = [];
    if ($this->mode === 'sampah') {
        $h[] = '<li><form method="post">' . $csrf . $balik . '<input type="hidden" name="aksi" value="pulihkan"><input type="hidden" name="kode" value="' . $e($b['kode']) . '"><button class="dropdown-item"><i class="bi bi-arrow-counterclockwise me-2"></i>Pulihkan</button></form></li>';
        $h[] = '<li><form method="post">' . $csrf . $balik . '<input type="hidden" name="aksi" value="hapus_permanen"><input type="hidden" name="kode" value="' . $e($b['kode']) . '"><button class="dropdown-item text-danger" data-judul="Hapus Permanen" data-tombol="Hapus Permanen" data-bahaya="1" data-konfirmasi="' . $e('<b>' . $this->escapeHtml($b['nama']) . '</b> akan dihapus permanen dan tidak bisa dikembalikan. Lanjutkan?') . '"><i class="bi bi-trash3 me-2"></i>Hapus permanen</button></form></li>';
    } else {
        if ($b['folder']) {
            $h[] = '<li><a class="dropdown-item" href="' . $e($b['alamat']) . '"><i class="bi bi-folder2-open me-2"></i>Buka</a></li>';
        } else {
            if ($b['pratinjau'] !== null) {
                $tulisLihat = in_array($b['hak'], ['pemilik', 'tulis'], true) && $b['sistem'] === null;
                $h[] = '<li><button type="button" class="dropdown-item berkas-lihat" data-jenis="' . $e($b['pratinjau']) . '" data-alamat="' . $e($b['alamat']) . '" data-nama="' . $e($b['nama']) . '" data-kode="' . $e($b['kode']) . '" data-tulis="' . ($tulisLihat ? '1' : '') . '" data-milik="' . ($b['milikSaya'] ? '1' : '') . '"' . '><i class="bi bi-eye me-2"></i>Lihat</button></li>';
            }
            $h[] = '<li><a class="dropdown-item" href="' . $e($b['alamatUnduh']) . '"><i class="bi bi-download me-2"></i>Unduh</a></li>';
        }
        $tulis = in_array($b['hak'], ['pemilik', 'tulis'], true) && $b['sistem'] === null;
        if ($tulis || $b['milikSaya']) {
            $h[] = '<li><hr class="dropdown-divider"></li>';
        }
        if ($tulis) {
            $h[] = '<li><button type="button" class="dropdown-item berkas-ganti-nama" data-kode="' . $e($b['kode']) . '" data-nama="' . $e($b['nama']) . '"><i class="bi bi-pencil me-2"></i>Ganti nama</button></li>';
        }
        if ($b['milikSaya'] && $b['sistem'] === null) {
            $h[] = '<li><button type="button" class="dropdown-item berkas-pindah" data-kode="' . $e($b['kode']) . '" data-nama="' . $e($b['nama']) . '"><i class="bi bi-folder-symlink me-2"></i>Pindah</button></li>';
        }
        if ($b['milikSaya']) {
            $h[] = '<li><button type="button" class="dropdown-item berkas-bagi" data-kode="' . $e($b['kode']) . '" data-nama="' . $e($b['nama']) . '"><i class="bi bi-share me-2"></i>Bagikan</button></li>';
        }
        if ($tulis) {
            $h[] = '<li><hr class="dropdown-divider"></li><li><form method="post">' . $csrf . $balik . '<input type="hidden" name="aksi" value="buang"><input type="hidden" name="kode" value="' . $e($b['kode']) . '"><button class="dropdown-item text-danger-emphasis"><i class="bi bi-trash me-2"></i>Buang ke sampah</button></form></li>';
        }
    }

    return '<div class="dropdown"><button class="btn btn-sm btn-link text-body p-0 px-1" type="button" data-bs-toggle="dropdown" data-bs-popper-config=\'{"strategy":"fixed"}\' aria-expanded="false" aria-label="Tindakan untuk ' . $e($b['nama']) . '"><i class="bi bi-three-dots-vertical"></i></button><ul class="dropdown-menu dropdown-menu-end">' . implode('', $h) . '</ul></div>';
};
$buka = function (array $b): string {
    if ($b['folder']) {
        return 'href="' . $this->escapeHtmlAttr($b['alamat']) . '"';
    }
    if ($this->mode !== 'sampah' && $b['pratinjau'] !== null) {
        $tulis = in_array($b['hak'], ['pemilik', 'tulis'], true) && $b['sistem'] === null;

        return 'href="' . $this->escapeHtmlAttr($b['alamat']) . '" data-lihat="1" data-jenis="' . $this->escapeHtmlAttr($b['pratinjau']) . '" data-alamat="' . $this->escapeHtmlAttr($b['alamat']) . '" data-nama="' . $this->escapeHtmlAttr($b['nama'])
            . '" data-kode="' . $this->escapeHtmlAttr($b['kode']) . '" data-tulis="' . ($tulis ? '1' : '') . '" data-milik="' . ($b['milikSaya'] ? '1' : '') . '"';
    }

    return $this->mode === 'sampah' ? '' : 'href="' . $this->escapeHtmlAttr((string) $b['alamatUnduh']) . '"';
};
