<script>
(() => {
    const dasar = <?= json_encode($dasar) ?>;
    const csrfNama = <?= json_encode($this->fieldCsrf) ?>;
    const csrf = <?= json_encode($this->tokenCsrf) ?>;
    const lokasiAktif = <?= json_encode($this->lokasiAktif) ?>;

    const kirim = async (data) => {
        const form = new FormData();
        form.append(csrfNama, csrf);
        form.append('json', '1');
        for (const [k, v] of Object.entries(data)) {
            form.append(k, v);
        }
        const jawab = await fetch(dasar, { method: 'POST', body: form, credentials: 'same-origin' });
        let isi = {};
        try { isi = await jawab.json(); } catch (_) { isi = { galat: 'Server menjawab ' + jawab.status + '.' }; }
        if (!jawab.ok || isi.galat) {
            throw new Error(isi.galat || ('Server menjawab ' + jawab.status + '.'));
        }
        return isi;
    };
    const teksAman = (s) => { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; };
    // Jendela dialog dashboard pengganti confirm()/prompt()/alert() browser, agar serasi dengan tema dan pesannya bisa
    // berformat. pesan berupa HTML yang sudah aman (nama dari server sudah di-escape; dari JavaScript lewat teksAman).
    const dialog = (() => {
        const el = document.getElementById('dapurDialog');
        const isian = document.getElementById('dapurDialogIsian');
        const ya = document.getElementById('dapurDialogYa');
        const batal = document.getElementById('dapurDialogBatal');
        let selesai = null;
        el.addEventListener('hidden.bs.modal', () => {
            // Bootstrap membuka kembali gulir halaman saat jendela ditutup; jaga bila jendela lain masih terbuka.
            if (document.querySelector('.modal.show')) {
                document.body.classList.add('modal-open');
            }
            if (selesai) { const s = selesai; selesai = null; s(null); }
        });
        document.getElementById('dapurDialogForm').addEventListener('submit', (e) => {
            e.preventDefault();
            const s = selesai;
            selesai = null;
            bootstrap.Modal.getOrCreateInstance(el).hide();
            s?.(isian.classList.contains('d-none') ? true : isian.value);
        });
        el.addEventListener('shown.bs.modal', () => (isian.classList.contains('d-none') ? ya : isian).focus());
        // Selalu di atas jendela lain (mis. Bagikan), dengan latar gelapnya di antara keduanya.
        el.style.zIndex = '1065';
        el.addEventListener('show.bs.modal', () => setTimeout(() => {
            const latar = document.querySelectorAll('.modal-backdrop');
            if (latar.length > 1) {
                latar[latar.length - 1].style.zIndex = '1060';
            }
        }));
        return ({ judul = 'Konfirmasi', pesan = '', tombol = 'Ya', bahaya = false, nilai = null, tanpaBatal = false }) => new Promise((hasil) => {
            selesai = hasil;
            el.querySelector('.modal-title').textContent = judul;
            document.getElementById('dapurDialogPesan').innerHTML = pesan;
            isian.classList.toggle('d-none', nilai === null);
            isian.value = nilai ?? '';
            ya.textContent = tombol;
            ya.className = 'btn fw-semibold ' + (bahaya ? 'btn-danger' : 'btn-success');
            batal.classList.toggle('d-none', tanpaBatal);
            bootstrap.Modal.getOrCreateInstance(el).show();
            if (nilai !== null) {
                el.addEventListener('shown.bs.modal', () => {
                    const titik = isian.value.lastIndexOf('.');
                    isian.setSelectionRange(0, titik > 0 ? titik : isian.value.length);
                }, { once: true });
            }
        });
    })();
    const teksDialog = (s) => { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; };
    const pesanGalat = (teks) => dialog({ judul: 'Tidak Berhasil', pesan: teksDialog(teks), tombol: 'Tutup', tanpaBatal: true });

    // Tombol dalam form dengan data-konfirmasi: tanyakan dulu, baru kirim form.
    document.addEventListener('click', async (e) => {
        const tombol = e.target.closest('[data-konfirmasi]');
        if (!tombol) {
            return;
        }
        e.preventDefault();
        const form = tombol.closest('form');
        const ok = await dialog({
            judul: tombol.dataset.judul || 'Konfirmasi',
            pesan: tombol.dataset.konfirmasi,
            tombol: tombol.dataset.tombol || 'Ya',
            bahaya: tombol.dataset.bahaya === '1',
        });
        if (ok && form) {
            form.submit();
        }
    });


    // Pratinjau.
    const modalLihat = document.getElementById('berkasPratinjau');
    const delegasi = (pemilih, fungsi) => document.addEventListener('click', (e) => {
        const el = e.target.closest(pemilih);
        if (el) {
            fungsi(el, e);
        }
    });

    // Menu klik kanan (dan tekan lama di layar sentuh): salinan menu ⋮ milik berkas itu, di posisi penunjuk.
    const konteks = document.getElementById('berkasKonteks');
    const tutupKonteks = () => konteks.classList.remove('show');
    document.addEventListener('contextmenu', (e) => {
        const item = e.target.closest('[data-berkas-item]');
        const menu = item?.querySelector('.dropdown-menu');
        if (!menu) {
            return;
        }
        e.preventDefault();
        konteks.innerHTML = menu.innerHTML;
        konteks.classList.add('show');
        const lebar = konteks.offsetWidth, tinggi = konteks.offsetHeight;
        konteks.style.left = Math.max(4, Math.min(e.clientX, window.innerWidth - lebar - 4)) + 'px';
        konteks.style.top = Math.max(4, Math.min(e.clientY, window.innerHeight - tinggi - 4)) + 'px';
        konteks.querySelector('.dropdown-item')?.focus();
    });
    document.addEventListener('click', (e) => { if (!konteks.contains(e.target) || e.target.closest('.dropdown-item')) { setTimeout(tutupKonteks); } });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { tutupKonteks(); } });
    window.addEventListener('scroll', tutupKonteks, true);
    window.addEventListener('resize', tutupKonteks);

    delegasi('.berkas-lihat, [data-lihat]', (el, e) => {
        e.preventDefault();
        const { jenis, alamat, nama } = el.dataset;
        const badan = modalLihat.querySelector('.modal-body');
        lihatAktif = { kode: el.dataset.kode, nama, tulis: el.dataset.tulis === '1' };
        const judul = document.getElementById('berkasPratinjauJudul');
        judul.textContent = nama;
        judul.classList.toggle('berkas-bisa-ganti', lihatAktif.tulis);
        judul.title = lihatAktif.tulis ? 'Klik untuk mengganti nama' : '';
        judul.classList.remove('d-none');
        document.getElementById('berkasPratinjauNama').classList.add('d-none');
        document.getElementById('berkasPratinjauBagi').classList.toggle('d-none', el.dataset.milik !== '1');
        document.getElementById('berkasPratinjauBuang').classList.toggle('d-none', !lihatAktif.tulis);
        document.getElementById('berkasPratinjauUnduh').href = alamat + '?unduh=1';
        badan.replaceChildren();
        let isi;
        if (jenis === 'gambar') { isi = document.createElement('img'); isi.alt = nama; }
        else if (jenis === 'video') { isi = document.createElement('video'); isi.controls = true; }
        else if (jenis === 'audio') { isi = document.createElement('audio'); isi.controls = true; isi.className = 'w-100'; }
        else { isi = document.createElement('iframe'); isi.title = nama; if (jenis === 'teks') { isi.setAttribute('sandbox', ''); } }
        isi.src = alamat;
        badan.append(isi);
        bootstrap.Modal.getOrCreateInstance(modalLihat).show();
    });
    let lihatAktif = null;
    let perluMuatUlang = false;
    modalLihat.addEventListener('hidden.bs.modal', () => {
        modalLihat.querySelector('.modal-body').replaceChildren();
        if (perluMuatUlang) {
            location.reload();
        }
    });

    // Nama di kepala pratinjau: klik untuk berubah menjadi kotak isian; Enter/keluar = simpan, Esc = batal.
    const judulLihat = document.getElementById('berkasPratinjauJudul');
    const isianNama = document.getElementById('berkasPratinjauNama');
    judulLihat.addEventListener('click', () => {
        if (!lihatAktif?.tulis) {
            return;
        }
        isianNama.value = lihatAktif.nama;
        judulLihat.classList.add('d-none');
        isianNama.classList.remove('d-none', 'is-invalid');
        isianNama.focus();
        const titik = lihatAktif.nama.lastIndexOf('.');
        isianNama.setSelectionRange(0, titik > 0 ? titik : lihatAktif.nama.length);
    });
    let simpanNama = async (batal) => {
        if (isianNama.classList.contains('d-none')) {
            return;
        }
        const baru = isianNama.value.trim();
        if (batal || baru === '' || baru === lihatAktif.nama) {
            isianNama.classList.add('d-none');
            judulLihat.classList.remove('d-none');
            return;
        }
        try {
            const isi = await kirim({ aksi: 'ganti_nama', kode: lihatAktif.kode, nama: baru });
            const nama = (isi.pesan.match(/"(.*)"/) || [null, baru])[1];
            lihatAktif.nama = nama;
            judulLihat.textContent = nama;
            isianNama.classList.add('d-none');
            judulLihat.classList.remove('d-none');
            perluMuatUlang = true;
        } catch (err) {
            // Batalkan isian dulu agar tidak tersimpan ulang saat fokus pindah ke jendela pesan.
            isianNama.classList.add('d-none');
            judulLihat.classList.remove('d-none');
            pesanGalat(err.message);
        }
    };
    isianNama.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); simpanNama(false); }
        if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); simpanNama(true); }
    });
    isianNama.addEventListener('blur', () => simpanNama(false));

    document.getElementById('berkasPratinjauBuang').addEventListener('click', async () => {
        if (!lihatAktif || !(await dialog({ judul: 'Buang ke Tempat Sampah', pesan: 'Buang <b>' + teksAman(lihatAktif.nama) + '</b> ke tempat sampah? Berkas masih bisa dipulihkan selama ' + <?= (int) $this->sampahHari ?> + ' hari.', tombol: 'Buang', bahaya: true }))) {
            return;
        }
        try {
            await kirim({ aksi: 'buang', kode: lihatAktif.kode });
            perluMuatUlang = true;
            bootstrap.Modal.getOrCreateInstance(modalLihat).hide();
        } catch (err) {
            pesanGalat(err.message);
        }
    });
    document.getElementById('berkasPratinjauBagi').addEventListener('click', () => {
        if (!lihatAktif) {
            return;
        }
        const data = { kode: lihatAktif.kode, nama: lihatAktif.nama };
        modalLihat.addEventListener('hidden.bs.modal', () => bukaBagi(data.kode, data.nama), { once: true });
        bootstrap.Modal.getOrCreateInstance(modalLihat).hide();
    });

    // Ganti nama.
    delegasi('.berkas-ganti-nama', async (el) => {
        const baru = await dialog({ judul: 'Ganti Nama', pesan: 'Nama baru untuk <b>' + teksAman(el.dataset.nama) + '</b>:', tombol: 'Simpan', nilai: el.dataset.nama });
        if (baru && baru !== el.dataset.nama) {
            const f = document.getElementById('berkasFormGantiNama');
            f.querySelector('[name=kode]').value = el.dataset.kode;
            f.querySelector('[name=nama]').value = baru;
            f.submit();
        }
    });

    // Pindah: pilihan folder diambil dari server.
    const modalPindah = document.getElementById('berkasPindah');
    delegasi('.berkas-pindah', async (el) => {
        modalPindah.querySelector('[name=kode]').value = el.dataset.kode;
        modalPindah.querySelector('.berkas-pindah-nama').textContent = el.dataset.nama;
        const pilih = modalPindah.querySelector('select');
        pilih.innerHTML = '<option>Memuat…</option>';
        bootstrap.Modal.getOrCreateInstance(modalPindah).show();
        try {
            const jawab = await fetch(dasar + '?daftar_folder=1&lokasi=' + encodeURIComponent(lokasiAktif), { credentials: 'same-origin' });
            const isi = await jawab.json();
            pilih.innerHTML = '<option value="">' + teksAman(isi.akar || 'Akar') + '</option>' + isi.folder
                .filter((f) => f.kode !== el.dataset.kode)
                .map((f) => '<option value="' + teksAman(f.kode) + '">' + teksAman(isi.akar + ' / ' + f.jalur) + '</option>').join('');
        } catch (_) {
            pilih.innerHTML = '<option value="">Daftar folder tidak bisa dimuat</option>';
        }
    });

    // Bagikan.
    const modalBagi = document.getElementById('berkasBagi');
    let kodeBagi = '';
    const pesanBagi = (teks, galat) => {
        const p = document.getElementById('berkasBagiPesan');
        p.className = 'alert small py-2 ' + (galat ? 'alert-danger' : 'alert-success');
        p.innerHTML = teks;
    };
    const muatBagi = async () => {
        const daftar = document.getElementById('berkasBagiDaftar');
        daftar.innerHTML = '<li class="list-group-item small text-body-secondary">Memuat…</li>';
        const jawab = await fetch(dasar + '?bagi=' + encodeURIComponent(kodeBagi), { credentials: 'same-origin' });
        const isi = await jawab.json();
        if (!isi.bagi.length) {
            daftar.innerHTML = '<li class="list-group-item small text-body-secondary">Belum dibagikan.</li>';
            return;
        }
        daftar.innerHTML = isi.bagi.map((b) => {
            const label = b.jenis === 'tautan'
                ? '<i class="bi bi-link-45deg me-1"></i><a href="' + teksAman(b.tujuan) + '" target="_blank" rel="noopener" class="text-break">' + teksAman(location.origin + b.tujuan) + '</a>' + (b.sampai ? ' <span class="text-body-secondary">(sampai ' + teksAman(b.sampai) + ')</span>' : '')
                : (b.jenis === 'user' ? '<i class="bi bi-person me-1"></i>' + teksAman(b.nama ? b.nama + ' (' + b.tujuan + ')' : b.tujuan) : '<i class="bi bi-people me-1"></i>Anggota ' + teksAman(b.tujuan === 'dashboard' ? 'dashboard utama' : b.tujuan));
            const hak = b.jenis === 'tautan'
                ? '<span class="badge text-bg-light border">hanya baca</span>'
                : '<select class="form-select form-select-sm w-auto berkas-ubah-hak" data-id="' + b.id + '" aria-label="Hak akses">'
                    + '<option value="baca"' + (b.hak === 'tulis' ? '' : ' selected') + '>Hanya baca</option>'
                    + '<option value="tulis"' + (b.hak === 'tulis' ? ' selected' : '') + '>Boleh menulis</option></select>';
            return '<li class="list-group-item d-flex justify-content-between align-items-center gap-2 small"><span class="text-break me-auto">' + label + '</span>' + hak
                + (b.jenis === 'tautan' ? '<button type="button" class="btn btn-sm btn-link berkas-salin" data-tautan="' + teksAman(location.origin + b.tujuan) + '" title="Salin tautan"><i class="bi bi-clipboard"></i></button>' : '')
                + '<button type="button" class="btn btn-sm btn-link text-danger-emphasis berkas-cabut" data-id="' + b.id + '" title="Cabut"><i class="bi bi-x-circle"></i></button></li>';
        }).join('');
    };
    const bukaBagi = (kode, nama) => {
        kodeBagi = kode;
        modalBagi.querySelector('.modal-title').textContent = 'Bagikan: ' + nama;
        document.getElementById('berkasBagiPesan').className = 'alert d-none';
        bootstrap.Modal.getOrCreateInstance(modalBagi).show();
        muatBagi();
    };
    delegasi('.berkas-bagi', (el) => bukaBagi(el.dataset.kode, el.dataset.nama));
    modalBagi.querySelectorAll('.berkas-bagi-form').forEach((f) => f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = { aksi: f.dataset.aksi, kode: kodeBagi };
        new FormData(f).forEach((v, k) => { data[k] = v; });
        try {
            const isi = await kirim(data);
            pesanBagi(teksAman(isi.pesan) + (isi.alamat ? ' <a href="' + teksAman(isi.alamat) + '" target="_blank" rel="noopener">' + teksAman(location.origin + isi.alamat) + '</a>' : ''), false);
            f.reset();
            muatBagi();
        } catch (err) {
            pesanBagi(teksAman(err.message), true);
        }
    }));
    document.getElementById('berkasBagiDaftar').addEventListener('change', async (e) => {
        const pilih = e.target.closest('.berkas-ubah-hak');
        if (!pilih) {
            return;
        }
        try {
            const isi = await kirim({ aksi: 'ubah_hak', kode: kodeBagi, bagi_id: pilih.dataset.id, hak: pilih.value });
            pesanBagi(teksAman(isi.pesan), false);
        } catch (err) {
            pesanBagi(teksAman(err.message), true);
            muatBagi();
        }
    });
    document.getElementById('berkasBagiDaftar').addEventListener('click', async (e) => {
        const salin = e.target.closest('.berkas-salin');
        if (salin) {
            navigator.clipboard?.writeText(salin.dataset.tautan).then(() => pesanBagi('Tautan disalin.', false));
            return;
        }
        const cabut = e.target.closest('.berkas-cabut');
        if (cabut && await dialog({ judul: 'Cabut Berbagi', pesan: 'Cabut berbagi ini? Orang atau tautan tersebut tidak bisa membuka berkas ini lagi.', tombol: 'Cabut', bahaya: true })) {
            try {
                await kirim({ aksi: 'cabut_bagi', kode: kodeBagi, bagi_id: cabut.dataset.id });
                pesanBagi('Berbagi dicabut.', false);
                muatBagi();
            } catch (err) {
                pesanBagi(teksAman(err.message), true);
            }
        }
    });
    modalBagi.addEventListener('hidden.bs.modal', () => location.reload());

    // Pohon folder di kiri: hanya terbuka lewat tanda panah. Klik nama lokasi atau membuka subfolder di panel kanan
    // tidak membuka pohon. Keadaan terbuka/tertutup diingat di browser (localStorage).
    const pohon = document.getElementById('berkasPohon');
    const SIMPAN = 'dapur-berkas-pohon';
    let keadaan = {};
    try { keadaan = JSON.parse(localStorage.getItem(SIMPAN) || '{}') || {}; } catch (_) { keadaan = {}; }
    const simpanKeadaan = () => { try { localStorage.setItem(SIMPAN, JSON.stringify(keadaan)); } catch (_) {} };
    const folderAktif = pohon.dataset.folderAktif;
    const alamatFolder = (kode) => dasar + '?folder=' + encodeURIComponent(kode) + (pohon.dataset.tampil ? '&tampil=ikon' : '');
    const dataLokasi = {};

    const buatCabang = (ul, daftar, induk, lokasi) => {
        ul.replaceChildren();
        for (const f of daftar.filter((x) => x.induk === induk)) {
            const punyaAnak = daftar.some((x) => x.induk === f.kode);
            const kunci = lokasi + ':' + f.kode;
            const li = document.createElement('li');
            li.innerHTML = '<div class="d-flex align-items-center"><button type="button" class="btn btn-sm btn-link text-body p-0 berkas-caret' + (punyaAnak ? '' : ' berkas-caret-kosong') + '" aria-expanded="false"><i class="bi bi-chevron-right"></i></button>'
                + '<a class="nav-link flex-grow-1 text-truncate' + (f.kode === folderAktif ? ' active' : '') + '" href="' + teksAman(alamatFolder(f.kode)) + '"><i class="bi bi-folder me-2"></i>' + teksAman(f.nama) + '</a></div>'
                + '<ul class="list-unstyled berkas-pohon mb-0" hidden></ul>';
            const caret = li.querySelector('.berkas-caret');
            const anak = li.querySelector('ul');
            caret.setAttribute('aria-label', 'Buka atau tutup ' + f.nama);
            const atur = (buka) => {
                caret.setAttribute('aria-expanded', buka ? 'true' : 'false');
                anak.hidden = !buka;
                if (buka && !anak.childElementCount) { buatCabang(anak, daftar, f.kode, lokasi); }
            };
            caret.addEventListener('click', () => { keadaan[kunci] = anak.hidden; simpanKeadaan(); atur(anak.hidden); });
            if (punyaAnak && keadaan[kunci]) { atur(true); }
            ul.append(li);
        }
    };

    pohon.querySelectorAll('.berkas-pohon-akar').forEach((akar) => {
        const lokasi = akar.dataset.lokasi;
        const kunci = 'lokasi:' + lokasi;
        const caret = akar.querySelector(':scope > div > .berkas-caret');
        const ul = akar.querySelector(':scope > ul');
        const atur = async (buka) => {
            caret.setAttribute('aria-expanded', buka ? 'true' : 'false');
            ul.hidden = !buka;
            if (!buka || dataLokasi[lokasi]) { return; }
            try {
                const jawab = await fetch(dasar + '?daftar_folder=1&lokasi=' + encodeURIComponent(lokasi), { credentials: 'same-origin' });
                dataLokasi[lokasi] = (await jawab.json()).folder || [];
            } catch (_) {
                dataLokasi[lokasi] = [];
            }
            buatCabang(ul, dataLokasi[lokasi], null, lokasi);
            if (!dataLokasi[lokasi].length) { caret.classList.add('berkas-caret-kosong'); }
        };
        caret.addEventListener('click', () => { keadaan[kunci] = ul.hidden; simpanKeadaan(); atur(ul.hidden); });
        if (keadaan[kunci]) { atur(true); }
    });

    // Unggah bertahap: setiap file dipotong (bawaan 1 MB) dan dikirim berurutan.
    const kotak = document.getElementById('berkasTarik');
    if (!kotak) {
        return;
    }
    const d = kotak.dataset;
    const daftar = document.getElementById('berkasDaftarUnggah');
    const antrean = [];
    let berjalan = false;

    const unggahSatu = async (file, jalur) => {
        const baris = document.createElement('li');
        const status = document.createElement('span');
        status.className = 'text-body-secondary';
        baris.append(document.createTextNode(jalur + ' '), status);
        daftar.append(baris);
        if (file.size > Number(d.maks)) {
            status.className = 'text-danger';
            status.textContent = 'terlalu besar';
            return false;
        }
        let kode = '';
        try {
            kode = (await kirim({ aksi: 'unggah_mulai', lokasi: d.lokasi, folder: d.folder, file: jalur, ukuran: file.size })).kode;
            const potongan = Number(d.potongan);
            for (let nomor = 0, awal = 0; awal < file.size; nomor++, awal += potongan) {
                await kirim({ aksi: 'unggah_potongan', kode_unggah: kode, nomor, potongan: file.slice(awal, awal + potongan) });
                status.textContent = Math.min(100, Math.round((awal + potongan) / file.size * 100)) + '%';
            }
            const hasil = await kirim({ aksi: 'unggah_selesai', kode_unggah: kode });
            status.className = 'text-success';
            status.textContent = hasil.pesan || 'selesai';
            return true;
        } catch (e) {
            status.className = 'text-danger';
            status.textContent = e.message;
            if (kode) {
                kirim({ aksi: 'unggah_batal', kode_unggah: kode }).catch(() => {});
            }
            return false;
        }
    };
    const jalankan = async () => {
        if (berjalan) {
            return;
        }
        berjalan = true;
        let berhasil = 0, gagal = 0;
        while (antrean.length) {
            const [file, jalur] = antrean.shift();
            if (await unggahSatu(file, jalur)) {
                berhasil++;
            } else {
                gagal++;
            }
        }
        berjalan = false;
        if (berhasil > 0 && gagal === 0) {
            // Semua berhasil: muat ulang daftar otomatis sebentar kemudian.
            const muat = document.createElement('li');
            muat.className = 'text-body-secondary';
            muat.textContent = 'Selesai. Memuat ulang daftar…';
            daftar.append(muat);
            setTimeout(() => location.reload(), 800);
        } else if (berhasil > 0) {
            // Ada yang gagal: daftar tidak dimuat ulang otomatis agar pesan galatnya tetap terbaca.
            const muat = document.createElement('li');
            muat.innerHTML = '<a href="#" class="fw-semibold">Muat ulang daftar berkas</a>';
            muat.querySelector('a').addEventListener('click', (e) => { e.preventDefault(); location.reload(); });
            daftar.append(muat);
        }
    };
    const tambah = (files) => {
        for (const file of files) {
            antrean.push([file, file.webkitRelativePath || file.name]);
        }
        bootstrap.Collapse.getOrCreateInstance(document.getElementById('berkasUnggah'), { toggle: false }).show();
        jalankan();
    };
    document.getElementById('berkasPilihFile').addEventListener('change', (e) => { tambah(e.target.files); e.target.value = ''; });
    document.getElementById('berkasPilihFolder').addEventListener('change', (e) => { tambah(e.target.files); e.target.value = ''; });
    ['dragenter', 'dragover'].forEach((n) => kotak.addEventListener(n, (e) => { e.preventDefault(); kotak.classList.add('berkas-tarik-aktif'); }));
    ['dragleave', 'drop'].forEach((n) => kotak.addEventListener(n, () => kotak.classList.remove('berkas-tarik-aktif')));
    kotak.addEventListener('drop', (e) => { e.preventDefault(); tambah(e.dataTransfer.files); });
})();
</script>
